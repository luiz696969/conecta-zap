# Copie este arquivo para .env e preencha com os dados do Meta for Developers
# (App > WhatsApp > API Setup)

# Token de acesso permanente (System User) ou temporário para testes
WHATSAPP_TOKEN=cole_seu_token_aqui

# ID do número de telefone (Phone Number ID, não é o número em si)
PHONE_NUMBER_ID=cole_o_phone_number_id_aqui

# Token de verificação do webhook (você inventa; tem que ser igual no painel da Meta)
VERIFY_TOKEN=conectazap2026

# Porta do servidor
PORT=3000

# true = envia pílulas como texto+imagem livre (só funciona na janela de 24h, bom para testes internos)
# false = envia via template aprovado na Meta (necessário na operação real)
MODO_LIVRE=true

# true = cron dispara a cada 10 minutos (teste acelerado) | false = todo dia às 9h
MODO_TESTE=false

# true = AMBIENTE DE TESTE: nada vai para a Meta; use o chat em http://localhost:3000/simulador
# Não precisa de token nem de número. Perfeito para desenvolver e gravar o vídeo demo.
MODO_SIMULACAO=true

# ===== TELEGRAM (canal aprovado pelo professor) =====
# Canal da operação real: "telegram" ou "whatsapp"
CANAL=telegram

# Token do bot criado no @BotFather (Telegram)
TELEGRAM_TOKEN=cole_o_token_do_botfather_aqui
